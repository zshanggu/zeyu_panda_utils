<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS profile for the panda-deoxys container: UDP only, no shared memory.
     The ZED publishers on this PC run as another Linux user, and Fast DDS shared-memory
     segments do not work across users, so subscribers here would discover topics but
     never receive data. Selected via FASTRTPS_DEFAULT_PROFILES_FILE in run.sh. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_only</transport_id>
            <type>UDPv4</type>
            <maxMessageSize>65500</maxMessageSize>
            <sendBufferSize>8388608</sendBufferSize>
            <receiveBufferSize>8388608</receiveBufferSize>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_only</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
